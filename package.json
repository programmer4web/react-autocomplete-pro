{
  "name": "react-autocomplete-pro",
  "version": "1.1.0",
  "description": "Advanced React autocomplete component with fuzzy search, rich results, multi-select, and TypeScript support. Features intelligent suggestions, category grouping, and async data loading.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "files": [
    "dist"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/programmer4web"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && rollup -c rollup.config.js && npm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/index.css --minify",
    "dev": "rollup -c rollup.config.js -w",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "lucide-react": ">=0.263.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tailwindcss/cli": "^4.3.4",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "lucide-react": "^0.525.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.67.4",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tailwindcss": "^4.3.4",
    "tslib": "^2.6.0",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "source-map-js": "^1.2.2",
    "browserslist": "^4.29.5",
    "picomatch": "^4.0.7"
  },
  "keywords": [
    "react",
    "autocomplete",
    "react-autocomplete",
    "typeahead",
    "combobox",
    "search",
    "fuzzy-search",
    "multi-select",
    "async",
    "typescript"
  ],
  "author": "Andrei-Constantin Alexandru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programmer4web/react-autocomplete-pro.git"
  },
  "bugs": {
    "url": "https://github.com/programmer4web/react-autocomplete-pro/issues"
  },
  "homepage": "https://github.com/programmer4web/react-autocomplete-pro#readme",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
